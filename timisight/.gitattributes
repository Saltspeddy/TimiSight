# Normalize line endings to LF in the repo for all text files, regardless of the
# OS a contributor is on. This prevents the whole tree showing as "modified" after a
# round-trip through a Windows machine (CRLF churn), and avoids spurious diffs/conflicts.
* text=auto eol=lf

# Keep Windows-specific scripts as CRLF so they run on Windows.
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew.bat text eol=crlf

# Treat known binary assets as binary (never touch their bytes).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.keystore binary
*.jar binary
*.aar binary
*.so binary
*.bundle binary
*.pdf binary
