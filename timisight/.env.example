# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# Supabase (Auth0 third-party auth). Public anon/publishable key — safe to embed client-side.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Maps Android API key for expo-maps, read at build time by app.config.js.
# IMPORTANT: restrict this key in Google Cloud Console to Android apps with
#   package name:  com.anonymous.timisight
#   SHA-1:         your debug keystore's SHA-1 fingerprint
# A Maps key ships inside the APK regardless; key restriction (not secrecy) is the
# real protection. Leave blank to build the app without a working map.
GOOGLE_MAPS_ANDROID_API_KEY=
